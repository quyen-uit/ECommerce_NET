                "key": "Origin",
                "value": "{{spaOrigin}}",
                "description": "Required for SPA origin validation"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/account/refresh",
              "host": ["{{baseUrl}}"],
              "path": ["api", "account", "refresh"]
            },
