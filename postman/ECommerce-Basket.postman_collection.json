{
  "info": {
    "name": "ECommerce NET - Basket",
    "description": "Collection for Shopping Basket management (Redis-backed)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Get Basket by ID",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/basket?id={{basketId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "basket"],
          "query": [
            {"key": "id", "value": "{{basketId}}"}
          ]
        },
        "description": "Get basket by ID (Anonymous access allowed)"
      }
    },
    {
      "name": "Create or Update Basket",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "if (pm.response.code === 200) {",
              "    const jsonData = pm.response.json();",
              "    if (jsonData.data && jsonData.data.id) {",
              "        pm.environment.set('basketId', jsonData.data.id);",
              "        console.log('Basket ID saved:', jsonData.data.id);",
              "    }",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{"key": "Content-Type", "value": "application/json"}],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"id\": \"basket-{{$randomUUID}}\",\n  \"items\": [\n    {\n      \"id\": \"{{productSkuId}}\",\n      \"productName\": \"Sample Product\",\n      \"price\": 99.99,\n      \"quantity\": 2,\n      \"photoUrl\": \"/images/product.jpg\",\n      \"brand\": \"Sample Brand\",\n      \"type\": \"Electronics\"\n    }\n  ]\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/basket",
          "host": ["{{baseUrl}}"],
          "path": ["api", "basket"]
        },
        "description": "Create or update basket (Anonymous access allowed)"
      }
    },
    {
      "name": "Delete Basket",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/basket?id={{basketId}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "basket"],
          "query": [
            {"key": "id", "value": "{{basketId}}"}
          ]
        },
        "description": "Delete basket by ID (Anonymous access allowed)"
      }
    }
  ]
}
