              "mode": "raw",
              "raw": "{\n  \"id\": \"{{productId}}\",\n  \"name\": \"Updated Product Name\",\n  \"description\": \"Updated description\",\n  \"categoryId\": \"{{categoryId}}\",\n  \"brandId\": \"{{brandId}}\"\n}"
