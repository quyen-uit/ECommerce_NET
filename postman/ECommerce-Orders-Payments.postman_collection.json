{
  "info": {
    "name": "ECommerce NET - Orders & Payments",
    "description": "Collection for Order management and Payment processing with Stripe",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Orders",
      "item": [
        {
          "name": "Create Order",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const jsonData = pm.response.json();",
                  "    if (jsonData.data && jsonData.data.id) {",
                  "        pm.environment.set('orderId', jsonData.data.id);",
                  "        console.log('Order ID saved:', jsonData.data.id);",
                  "    }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{"key": "token", "value": "{{accessToken}}", "type": "string"}]
            },
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"basketId\": \"basket-123\",\n  \"deliveryMethod\": \"standard\",\n  \"shipToAddress\": {\n    \"firstName\": \"John\",\n    \"lastName\": \"Doe\",\n    \"street\": \"123 Main St\",\n    \"city\": \"New York\",\n    \"state\": \"NY\",\n    \"zipCode\": \"10001\"\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/order",
              "host": ["{{baseUrl}}"],
              "path": ["api", "order"]
            },
            "description": "Create a new order from basket"
          }
        },
        {
          "name": "Get All Orders",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{"key": "token", "value": "{{accessToken}}", "type": "string"}]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/order",
              "host": ["{{baseUrl}}"],
              "path": ["api", "order"]
            },
            "description": "Get all orders for current user"
          }
        },
        {
          "name": "Get Order by ID",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{"key": "token", "value": "{{accessToken}}", "type": "string"}]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/order/{{orderId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "order", "{{orderId}}"]
            },
            "description": "Get order details by ID"
          }
        },
        {
          "name": "Get Delivery Methods",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{"key": "token", "value": "{{accessToken}}", "type": "string"}]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/order/delivery-methods",
              "host": ["{{baseUrl}}"],
              "path": ["api", "order", "delivery-methods"]
            },
            "description": "Get all available delivery methods"
          }
        }
      ]
    },
    {
      "name": "Payments",
      "item": [
        {
          "name": "Create or Update Payment Intent",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{"key": "token", "value": "{{accessToken}}", "type": "string"}]
            },
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/payment/{{basketId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "payment", "{{basketId}}"]
            },
            "description": "Create or update Stripe payment intent for basket"
          }
        },
        {
          "name": "Stripe Webhook",
          "request": {
            "method": "POST",
            "header": [
              {"key": "Content-Type", "value": "application/json"},
              {"key": "Stripe-Signature", "value": "stripe_signature_here"}
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"payment_intent.succeeded\",\n  \"data\": {\n    \"object\": {\n      \"id\": \"pi_xxx\"\n    }\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/payment/webhook",
              "host": ["{{baseUrl}}"],
              "path": ["api", "payment", "webhook"]
            },
            "description": "Stripe webhook endpoint (for testing - normally called by Stripe)"
          }
        }
      ]
    }
  ]
}
