            },
            "method": "DELETE",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "[\"id1\", \"id2\", \"id3\"]"
            },
            "url": {
              "raw": "{{baseUrl}}/api/size/delete-many",
              "host": ["{{baseUrl}}"],
              "path": ["api", "size", "delete-many"]
            }
          }
        }
      ]
    }
  ]
}
